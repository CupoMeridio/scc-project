# FILE: docker/Dockerfile.frontend
# RUOLO: Immagine NGINX non-root per la Web UI (Login + 3 Dashboard HTML/CSS/JS).

# Base image fissata per digest (indice multi-arch): output di
#   docker buildx imagetools inspect nginxinc/nginx-unprivileged:alpine-slim
# archiviato in docs/audit_reports/base_images_digests.txt.
FROM nginxinc/nginx-unprivileged:alpine-slim@sha256:a8cb0f33d51fa107c96fd2bd3a71aaf564ec131e9d2bdf8700944f0ed8b170d7

COPY --chown=101:101 frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --chown=101:101 frontend/index.html /usr/share/nginx/html/index.html
COPY --chown=101:101 frontend/patient.html /usr/share/nginx/html/patient.html
COPY --chown=101:101 frontend/doctor.html /usr/share/nginx/html/doctor.html
COPY --chown=101:101 frontend/manager.html /usr/share/nginx/html/manager.html
COPY --chown=101:101 frontend/css/ /usr/share/nginx/html/css/
COPY --chown=101:101 frontend/js/ /usr/share/nginx/html/js/
COPY --chown=101:101 frontend/vendor/ /usr/share/nginx/html/vendor/

USER 101:101
EXPOSE 8080
